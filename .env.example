# Copy to .env and adjust. All variables are prefixed with CUEAI_.

# SQLAlchemy async connection URL (asyncpg driver).
CUEAI_DATABASE_URL=postgresql+asyncpg://cueai:cueai@localhost:5432/cueai

# Comma-separated list of allowed CORS origins ("*" allows all — fine while there is no auth).
CUEAI_CORS_ORIGINS=["*"]

# dev | prod | test
CUEAI_APP_ENV=dev

# Echo SQL statements (noisy; dev only).
CUEAI_DB_ECHO=false

# Root log level.
CUEAI_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------- chat agent

# Ollama endpoint and the model it should serve (pull it first: `ollama pull qwen3:8b`).
CUEAI_OLLAMA_BASE_URL=http://localhost:11434
CUEAI_OLLAMA_MODEL=qwen3:8b
# Context window. 8192 keeps qwen3:8b GPU-resident on an 8 GB card; too small silently
# truncates prompts and breaks tool calling.
CUEAI_OLLAMA_NUM_CTX=8192
CUEAI_OLLAMA_TEMPERATURE=0

# postgres (conversations + memory survive restarts; uses CUEAI_DATABASE_URL) | memory
CUEAI_AGENT_PERSISTENCE=postgres
CUEAI_AGENT_DB_POOL_SIZE=5
# Max seconds for one chat turn (a turn can involve up to three model calls).
CUEAI_AGENT_TURN_TIMEOUT_S=120

# User assumed when the X-User-Id header is absent (until real auth exists).
CUEAI_DEFAULT_USER_ID=default
